    <body style="font-size:40px; text-align:center;">
    <h2>Gesture Speaker 🔊</h2>

    <button onclick="start()" style="font-size:30px;">Start 🔊</button>

    <h1 id="text">Waiting...</h1>

    <script>
    let last = "";
    let started = false;

    function start() {
        started = true;

        // 🔥 unlock audio
        let msg = new SpeechSynthesisUtterance("Started");
        speechSynthesis.speak(msg);

        poll();
    }

    async function poll() {
        if (!started) return;

        try {
            let res = await fetch('/latest');
            let text = await res.text();

            if (text !== "" && text !== last) {
                last = text;

                let msg = new SpeechSynthesisUtterance(text);
                msg.rate = 1;
                msg.pitch = 1;
                msg.volume = 1;

                speechSynthesis.speak(msg);

                document.getElementById("text").innerText = text;
            }
        } catch(e) {}

        setTimeout(poll, 800);
    }
    </script>

    </body>
    </html>
    '''


if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5001)
